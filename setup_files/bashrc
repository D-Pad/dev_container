#
# ~/.bashrc
#

# If not running interactively, don't do anything
clear

# Environment variables
export EDITOR='nvim'
export VISUAL='nvim'
export PATH="$PATH:/usr/local/software/bash:/usr/local/software/bin"
export TERM='xterm-256color'

# Aliases
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias vim='nvim'
alias vi='nvim'
alias dblogin="PGPASSWORD=dev_db psql -U dev -h dev_db -p 5433 dev_db"
alias psearch='/usr/local/software/python/scripts/project_search.py'

# Custom terminal ID
Ccol="\e[1;36m"
Rcol="\e[1;31m"
Ncol="\e[0m"
PS1="\[$Ccol\][dpad\[$Rcol\]@\[$Ccol\]\h \[$Rcol\]\W\[$Ccol\]]\[$Ncol\]\$ "

# Pyenv
export PATH="/root/.pyenv/bin:$PATH"
eval "$(pyenv init --path)"

# Java JDK
export JAVA_HOME=/usr/lib/jvm/java-26-openjdk
export PATH="$JAVA_HOME/bin:$PATH"


function nvimPlugs() {
    if [[ "$(tmux ls 2> /dev/null | grep 'install')" =~ "install" ]]; then 
        echo "0"
    else
        echo "1" 
    fi
}


function installParu() {
    
    if which paru > /dev/null 2>&1; then
        echo -e "\e[1;31mParu is already installed\e[0m"
    
    else
        cd ~/
        git clone https://aur.archlinux.org/paru.git paru
        cd paru
        makepkg -si
    
    fi

}



function runMongoDb() {

    if which mongod > /dev/null 2>&1; then 
        echo -e "\e[32mMongoDB is installed\e[0m" 

    else
        installParu
        paru -S mongodb-bin
        sudo touch /var/log/mongodb/mongod.log
        sudo chmod 777 /var/log/mongodb
        sudo chmod 666 /var/log/mongodb/mongod.log

    fi

    echo -e "\e[1;33mStarting MongoDB service\e[0m"
    mongod --dbpath /usr/local/share/mongo \
        --bind_ip 127.0.0.1 \
        --logpath /var/log/mongodb/mongod.log \
        --logappend \
        --fork

}


installing=$(nvimPlugs)
if [[ $installing == "0" ]]; then
    
    echo -e "\e[1;31mNeovim plugins are installing\e[1;33m"
    count=1
    
    while [[ $installing == "0" ]]
    do 
        case "$count" in 

            "1")
                echo -ne "-- \033[0K\r"
                ;;
            "2")
                echo -ne "\\ \033[0K\r"
                ;;
            "3")
                echo -ne "|| \033[0K\r"
                ;;
            "4")
                echo -ne "// \\033[0K\r"
                count=0 
                ;;
        esac
        sleep 0.25 
        ((count=count+1)) 
        installing=$(nvimPlugs)
     
    done
    echo -e "\e[1;36mNeovim plugins installed\e[0m"

fi

