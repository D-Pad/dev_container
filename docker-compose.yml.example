services:

  dev:
    build: .
    stdin_open: true
    tty: true
    container_name: dev
    hostname: developer
    restart: always
    volumes:
      - type: bind 
        source: ../some_path
        target: /usr/local/mounted_path
    ports: 
      - 5000-5003:5000-5003
      - 3000-3003:3000-3003 
      - 8443:8443 
      - 50051:50051 
    networks:
      - dpad_llc
      - homelab

    # Environment variables for easily launching development servers
    environment:
      - TEST_PORT=3000
 
  dev_postgre_db:
    image: postgres:latest
    container_name: dev_postgre_db 
    restart: always
    hostname: dev_postgre_db
    shm_size: 128mb
    ports: 
      - 5433:5433
    command: -p 5433
    volumes:
      - type: bind 
        source: ./database/postgre/pgdata
        target: /var/lib/postgresql
      - type: bind 
        source: ./database/postgre/01-setup.sql
        target: /docker-entrypoint-initdb.d/01-setup.sql
    environment:
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_DB=${POSTGRES_DB}
    networks:
      - some_net 

  dev_maria_db:
    image: mariadb:latest
    container_name: dev_maria_db 
    restart: always
    hostname: dev_maria_db
    volumes:
      - type: bind 
        source: ./database/maria/.db
        target: /var/lib/mysql
      - type: bind 
        source: ./database/maria/perms.sql
        target: /docker-entrypoint-initdb.d/perms.sql
    environment:
      - MARIADB_ROOT_PASSWORD=${MARIADB_ROOT_PASSWORD}
    networks:
      - some_net 


volumes:
  dpad_llc_app:
    external: true

networks:
  some_net:
    driver: bridge
    name: some_net 
 
